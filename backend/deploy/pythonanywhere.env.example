# Copiar a /home/crismp/.config/cisternas/backend.env y completar en el servidor.
# Nunca subir el archivo completado a GitHub.
SECRET_KEY=
DATABASE_URL=
# MySQL: verificar HOST y nombre exacto en la pestaña Databases.
# DATABASE_URL='mysql+pymysql://crismp:CONTRASENA_URLENCODED@HOST/crismp$cisternas?charset=utf8mb4'
# PostgreSQL requiere un plan compatible; usar la URI privada de la base real.
# SQLite solo para pruebas de bajo volumen, con ruta absoluta y respaldo:
# DATABASE_URL=sqlite:////home/crismp/.local/share/cisternas/cisternas.db
CORS_ORIGINS=https://crismp.pythonanywhere.com
SESSION_DURATION_MINUTES=30
ADMIN_PASSWORD=
USER_PASSWORD=
CLIENT_PASSWORD=
CISTERNAS_REPO_DIR=/home/crismp/cargio_cisterna
